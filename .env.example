# Copy this file to .env and fill in real values.
#   PowerShell:  Copy-Item .env.example .env
# .env is gitignored; this example file is committed on purpose.

# --- Database (required) -------------------------------------------------
# Leave unset to fall back to local SQLite at backend/data/kundali.db
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD_HERE@127.0.0.1:5432/kundali

# --- Frontend / CORS -----------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173

# --- Google providers (optional) ----------------------------------------
# When these are blank the app falls back to OpenStreetMap + timezonefinder.
ENABLE_GOOGLE_PROVIDER=true
GOOGLE_PLACES_API_KEY=
GOOGLE_TIMEZONE_API_KEY=

# --- OpenStreetMap / Nominatim ------------------------------------------
# Their usage policy asks for a real contact address here.
NOMINATIM_USER_AGENT=kundali-web-app/0.1 (contact: you@example.com)

# --- Sessions ------------------------------------------------------------
SESSION_COOKIE_NAME=kundali_session
SESSION_DURATION_HOURS=168
# Set to true in production so the session cookie is HTTPS-only.
SESSION_SECURE_COOKIE=false

# --- Rate limiting -------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS=80
RATE_LIMIT_WINDOW_SECONDS=60

# --- Swiss Ephemeris -----------------------------------------------------
# Directory holding .se1 files. Defaults to backend/ephe/ when unset.
SWISS_EPHE_PATH=
